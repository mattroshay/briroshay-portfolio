# Sanity — get these from sanity.io/manage after running `npx sanity init` in /studio
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: a read token for previewing draft content (not required for published reads,
# since the dataset is public-readable by default).
SANITY_API_READ_TOKEN=
