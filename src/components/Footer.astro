---
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---
<footer class="foot wrap">
  <div class="foot-name">
    <span>Bri</span>
    <span class="echo">Bri</span>
    <span class="ampr">&amp;</span>
    <span>Roshay</span>
  </div>
  <div class="foot-meta">
    <span>© {year} {t.footer.copyrightSuffix}</span>
    <span>{t.footer.byline}</span>
    <span>briroshay.com</span>
  </div>
</footer>
