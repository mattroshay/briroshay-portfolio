---
import { getLocaleFromUrl, useTranslations, localePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---
<header class="border-b border-black/5">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-6">
    <a href={localePath(locale, '/')} class="text-xl tracking-tight font-medium">
      {t.site.title}
    </a>
    <nav class="flex items-center gap-6 text-sm">
      <a href={localePath(locale, '/paintings')}>{t.nav.paintings}</a>
      <a href={localePath(locale, '/sculptures')}>{t.nav.sculptures}</a>
      <a href={localePath(locale, '/about')}>{t.nav.about}</a>
      <a href={localePath(locale, '/contact')}>{t.nav.contact}</a>
      <LanguageSwitcher />
    </nav>
  </div>
</header>
