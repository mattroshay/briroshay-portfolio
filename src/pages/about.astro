---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations, localePath } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---
<BaseLayout title={t.about.title} canonicalPath="/about" navKey="about">
  <header class="page-head wrap">
    <div class="page-head-bar">
      <a href={localePath(locale, '/')} class="page-back">
        <span aria-hidden="true">←</span>
        <span>{t.nav.backToStudio}</span>
      </a>
      <div class="mono-sm">/04 — {t.about.label}</div>
    </div>
    <h1 class="page-title fade-up">
      {t.about.titleA}<span class="accent">{t.about.titleAccent}</span>{t.about.titleB}
    </h1>
    {t.about.blurb && (
      <p class="page-blurb fade-up" style="transition-delay: 120ms;">{t.about.blurb}</p>
    )}
  </header>

  <section class="section wrap">
    <div class="about-grid">
      <div class="portrait fade-up">
        <div class="portrait-tape"></div>
        <div class="art-ph warm">{t.about.portraitPh}</div>
      </div>
      <div class="about-body fade-up" style="transition-delay: 120ms;">
        <p>{t.about.bio}</p>
        <p style="color: var(--color-fg-mute); font-style: italic;">{t.about.quote}</p>
        <div class="signatures">
          <span class="sig">{t.about.signatures.one}</span>
          <span class="sig">{t.about.signatures.two}</span>
          <span class="sig">{t.about.signatures.three}</span>
        </div>
        <div class="about-stats">
          <div class="s">
            <div class="n">{t.about.stats.yearsN}</div>
            <div class="l">{t.about.stats.yearsL}</div>
          </div>
          <div class="s">
            <div class="n">{t.about.stats.originalsN}</div>
            <div class="l">{t.about.stats.originalsL}</div>
          </div>
          <div class="s">
            <div class="n">{t.about.stats.exhibitionsN}</div>
            <div class="l">{t.about.stats.exhibitionsL}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
