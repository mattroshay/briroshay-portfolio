---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---
<BaseLayout title={t.about.title} canonicalPath="/about">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl md:text-5xl mb-8">{t.about.title}</h1>
    <p class="text-lg text-[color:var(--color-muted)]">
      {/* TODO: mom's artist statement / bio goes here. Move to Sanity later if it needs editing. */}
    </p>
  </section>
</BaseLayout>
