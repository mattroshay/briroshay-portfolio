---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArtworksByType, getArtworkBySlug } from '../../../lib/queries';
import { urlFor } from '../../../lib/sanity';
import { pickLocale, getLocaleFromUrl, useTranslations, localePath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/utils';

export async function getStaticPaths() {
  // FR detail routes are keyed on the English slug (mirrors EN), so URLs stay
  // stable across locales — slugs only diverge when Bri explicitly sets them.
  let paintings: Awaited<ReturnType<typeof getArtworksByType>> = [];
  try {
    paintings = await getArtworksByType('painting');
  } catch {
    return [];
  }
  return paintings
    .map((artwork) => {
      const slug = artwork.slug?.en;
      if (!slug) return null;
      return { params: { slug }, props: { artworkId: artwork._id } };
    })
    .filter(Boolean);
}

const { slug } = Astro.params;
const locale: Locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

if (!slug) return Astro.redirect(localePath(locale, '/paintings'));
const artwork = await getArtworkBySlug(slug, 'en');
if (!artwork) return Astro.redirect(localePath(locale, '/paintings'));

const title = pickLocale(artwork.title, locale) ?? '';
const description = pickLocale(artwork.description, locale);
const seoDescription = pickLocale(artwork.seoDescription, locale) ?? description;
const mediumDetails = pickLocale(artwork.mediumDetails, locale);
const primary = artwork.images?.find((i) => i.isPrimary) ?? artwork.images?.[0];
const alt = pickLocale(primary?.alt, locale) ?? title;

const dimensionsText = artwork.dimensions
  ? `${artwork.dimensions.width} × ${artwork.dimensions.height}${
      artwork.dimensions.depth ? ` × ${artwork.dimensions.depth}` : ''
    } ${artwork.dimensions.unit}`
  : null;

const statusLabel = {
  available: t.artwork.available,
  sold: t.artwork.sold,
  reserved: t.artwork.reserved,
  not_for_sale: t.artwork.notForSale,
}[artwork.status];

const ogImage = primary
  ? urlFor(primary).width(1200).height(630).fit('crop').auto('format').url()
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: title,
  description: seoDescription,
  artMedium: mediumDetails,
  artform: 'Painting',
  artworkSurface: mediumDetails,
  dateCreated: artwork.dateCreated,
  width: artwork.dimensions ? `${artwork.dimensions.width} ${artwork.dimensions.unit}` : undefined,
  height: artwork.dimensions ? `${artwork.dimensions.height} ${artwork.dimensions.unit}` : undefined,
  creator: { '@type': 'Person', name: 'Bri Roshay' },
  image: primary ? urlFor(primary).width(1600).auto('format').url() : undefined,
};
---
<BaseLayout
  title={title}
  description={seoDescription}
  canonicalPath={`/paintings/${slug}`}
  ogImage={ogImage}
  navKey="paintings"
>
  <header class="page-head wrap">
    <div class="page-head-bar">
      <a href={localePath(locale, '/paintings')} class="page-back">
        <span aria-hidden="true">←</span>
        <span>{t.paintings.backToPaintings}</span>
      </a>
      <div class="mono-sm">/01 — {t.paintings.label}</div>
    </div>
    <h1 class="page-title fade-up" style="font-size: clamp(40px, 8vw, 96px);">
      {title}
    </h1>
  </header>

  <article class="section wrap">
    <div class="about-grid">
      <div class="fade-up">
        {primary ? (
          <div class="hero-art" style="aspect-ratio: auto;">
            <img
              src={urlFor(primary).width(1200).auto('format').url()}
              srcset={[600, 1200, 1600, 2400]
                .map((w) => `${urlFor(primary).width(w).auto('format').url()} ${w}w`)
                .join(', ')}
              sizes="(max-width: 768px) 100vw, 50vw"
              alt={alt}
              style="position: static; width: 100%; height: auto;"
            />
          </div>
        ) : (
          <div class="portrait">
            <div class="art-ph warm">{'◆ PEINTURE\nPHOTO'}</div>
          </div>
        )}
      </div>

      <div class="about-body fade-up" style="transition-delay: 120ms;">
        {description && <p>{description}</p>}

        <dl class="artwork-meta">
          {artwork.dateCreated && (
            <div class="row">
              <dt class="mono-sm">{t.artwork.dateCreated}</dt>
              <dd>{new Date(artwork.dateCreated).getFullYear()}</dd>
            </div>
          )}
          {mediumDetails && (
            <div class="row">
              <dt class="mono-sm">{t.artwork.medium}</dt>
              <dd>{mediumDetails}</dd>
            </div>
          )}
          {dimensionsText && (
            <div class="row">
              <dt class="mono-sm">{t.artwork.dimensions}</dt>
              <dd>{dimensionsText}</dd>
            </div>
          )}
          <div class="row">
            <dt class="mono-sm">{t.artwork.status}</dt>
            <dd>{statusLabel}</dd>
          </div>
        </dl>

        {artwork.status === 'available' && (
          <div style="margin-top: var(--gap-md);">
            <a href={localePath(locale, '/contact')} class="btn-filled">
              {t.artwork.enquire} →
            </a>
          </div>
        )}
      </div>
    </div>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .artwork-meta {
    margin-top: var(--gap-md);
    border-top: 1px solid var(--color-line-soft);
  }
  .artwork-meta .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--gap-md);
    align-items: baseline;
    padding: var(--gap-sm) 0;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .artwork-meta dt { color: var(--color-fg-mute); }
  .artwork-meta dd {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-fg);
  }
</style>
