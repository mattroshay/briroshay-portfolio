---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArtworkCard from '../../../components/ArtworkCard.astro';
import { getArtworksByType } from '../../../lib/queries';
import { getLocaleFromUrl, useTranslations } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

let paintings: Awaited<ReturnType<typeof getArtworksByType>> = [];
try {
  paintings = await getArtworksByType('painting');
} catch {
  paintings = [];
}

const filters = [
  { key: 'all', label: t.paintings.filterAll },
  { key: 'oil', label: t.paintings.filterOil },
  { key: 'acrylic', label: t.paintings.filterAcrylic },
  { key: 'watercolour', label: t.paintings.filterWatercolour },
  { key: 'mixed_media', label: t.paintings.filterMixedMedia },
  { key: 'other', label: t.paintings.filterOther },
] as const;
---
<BaseLayout title={t.paintings.title} canonicalPath="/paintings">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-4xl md:text-5xl mb-8">{t.paintings.title}</h1>

    <div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label="Medium filter">
      {filters.map(({ key, label }) => (
        <button
          type="button"
          data-filter={key}
          class="filter-chip text-sm px-3 py-1 border border-black/15 rounded-full hover:bg-black/5 transition"
          data-active={key === 'all'}
        >
          {label}
        </button>
      ))}
    </div>

    {paintings.length === 0 ? (
      <p class="text-[color:var(--color-muted)]">{t.paintings.empty}</p>
    ) : (
      <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {paintings.map((artwork) => (
          <div data-medium={artwork.mediumCategory ?? 'other'}>
            <ArtworkCard artwork={artwork} />
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // Lightweight client-side filter — no framework needed.
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('#gallery > [data-medium]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? 'all';
      chips.forEach((c) => (c.dataset.active = String(c.dataset.filter === filter)));
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.medium === filter;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .filter-chip[data-active="true"] {
    background: var(--color-ink);
    color: var(--color-canvas);
    border-color: var(--color-ink);
  }
</style>
