---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---
<BaseLayout title={t.contact.title} canonicalPath="/contact">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl md:text-5xl mb-8">{t.contact.title}</h1>
    <p class="text-lg text-[color:var(--color-muted)]">
      {/* TODO: mom's email / form goes here. */}
    </p>
  </section>
</BaseLayout>
