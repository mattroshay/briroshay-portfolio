---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleFromUrl, useTranslations, localePath } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const featured = [
  { kind: 'painting',  src: '/art/paintings/painting-01.jpg',   span: 'tall'   },
  { kind: 'painting',  src: '/art/paintings/painting-02.jpg',   span: 'square' },
  { kind: 'painting',  src: '/art/paintings/painting-03.jpg',   span: 'square' },
  { kind: 'sculpture', src: '/art/sculptures/sculpture-01.jpg', span: 'square' },
  { kind: 'sculpture', src: '/art/sculptures/sculpture-02.jpg', span: 'square' },
] as const;
---
<BaseLayout canonicalPath="/" description={t.site.description} navKey="home">
  {/* ── HERO ── */}
  <section class="hero wrap" id="top">
    <div class="hero-bar">
      <span>◐ {t.home.hero.studio}</span>
      <span class="status-pill">
        <span class="dot"></span>
        {t.home.hero.available}
      </span>
    </div>

    <div class="hero-grid">
      <div>
        <h1 class="hero-name fade-up">
          <span class="l1">{t.home.hero.line1}</span>
          <span class="l2">
            <span class="outline">{t.home.hero.line2}</span><span class="ampersand"> ✦</span>
          </span>
        </h1>
        <p class="hero-kicker fade-up" style="transition-delay: 120ms;">{t.home.hero.kicker}</p>
        <div class="hero-meta fade-up" style="transition-delay: 200ms;">
          <span><b>30+</b> {t.home.hero.metaYears}</span>
          <span><b>120+</b> {t.home.hero.metaWorks}</span>
          <span><b>14</b> {t.home.hero.metaShows}</span>
        </div>
      </div>

      <div class="hero-art fade-up" style="transition-delay: 240ms;">
        <img src="/art/paintings/painting-01.jpg" alt={t.home.featured.paintingAlt} loading="eager" />
      </div>
    </div>

    <div class="hero-credits fade-up" style="transition-delay: 300ms;">
      <span>{t.home.hero.creditPainter}</span>
      <span class="sep">✦</span>
      <span>{t.home.hero.creditSculptor}</span>
      <span class="sep">✦</span>
      <span>{t.home.hero.creditCountry}</span>
      <span class="sep">✦</span>
      <span>{t.home.hero.creditYear}</span>
    </div>
  </section>

  {/* ── FEATURED ── */}
  <section class="section wrap">
    <div class="section-head">
      <div>
        <div class="section-num">{t.home.featured.label}</div>
        <h2 class="section-title fade-up">
          {t.home.featured.title}<span class="accent">{t.home.featured.titleAccent}</span>
        </h2>
      </div>
      <p class="section-blurb fade-up" style="transition-delay: 120ms;">
        {t.home.featured.blurb}
      </p>
    </div>

    <div class="gallery">
      {featured.map((piece) => {
        const alt = piece.kind === 'sculpture' ? t.home.featured.sculptureAlt : t.home.featured.paintingAlt;
        const href = localePath(locale, piece.kind === 'sculpture' ? '/sculptures' : '/paintings');
        return (
          <a href={href} class={`art-card span-${piece.span}`} aria-label={alt}>
            <img src={piece.src} alt={alt} loading="lazy" />
          </a>
        );
      })}
    </div>

    <div class="section-action">
      <a href={localePath(locale, '/paintings')} class="btn-line">
        {t.home.featured.allPaintings} →
      </a>
      <a href={localePath(locale, '/sculptures')} class="btn-line">
        {t.home.featured.allSculptures} →
      </a>
    </div>
  </section>

  {/* ── ABOUT TEASER ── */}
  <section class="section wrap">
    <div class="home-about">
      <div class="portrait fade-up">
        <div class="portrait-tape"></div>
        <div class="art-ph warm">{t.home.about.portraitPh}</div>
      </div>
      <div class="fade-up" style="transition-delay: 120ms;">
        <div class="section-num">{t.home.about.label}</div>
        <h2 class="section-title" style="font-size: clamp(40px, 8vw, 96px);">
          {t.home.about.titleA}<span class="accent">{t.home.about.titleAccent}</span><br />{t.home.about.titleB}
        </h2>
        <p style="margin-top: var(--gap-md); color: var(--color-fg-soft); font-size: 15px; max-width: 52ch; line-height: 1.6;">
          {t.home.about.blurb}
        </p>
        <div style="margin-top: var(--gap-md);">
          <a href={localePath(locale, '/about')} class="btn-line">
            {t.home.about.readMore} →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── SHOP TEASER ── */}
  <section class="section wrap">
    <div class="shop">
      <div class="shop-grid">
        <div>
          <h3 class="fade-up">
            {t.shop.headingA}<br /><span class="accent2">{t.shop.headingAccent}</span> ✦
          </h3>
          <p class="shop-blurb">{t.shop.blurb}</p>
          <div class="shop-list">
            <div class="row">
              <span>{t.shop.rows.originalsLabel}</span>
              <span class="px">{t.shop.rows.originalsPrice}</span>
            </div>
            <div class="row">
              <span>{t.shop.rows.sculpturesLabel}</span>
              <span class="px">{t.shop.rows.sculpturesPrice}</span>
            </div>
            <div class="row">
              <span>{t.shop.rows.printsLabel}</span>
              <span class="px">{t.shop.rows.printsPrice}</span>
            </div>
            <div class="row">
              <span>{t.shop.rows.commissionsLabel}</span>
              <span class="px">{t.shop.rows.commissionsPrice}</span>
            </div>
          </div>
        </div>
        <div class="shop-actions">
          <a href={localePath(locale, '/contact')} class="btn-filled">
            {t.shop.inquireNow} →
          </a>
          <span class="mono-sm" style="align-self: center;">{t.shop.comingSoon}</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
