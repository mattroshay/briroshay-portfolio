---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import { getArtworksByType } from '../../lib/queries';
import { getLocaleFromUrl, useTranslations } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

let sculptures: Awaited<ReturnType<typeof getArtworksByType>> = [];
try {
  sculptures = await getArtworksByType('sculpture');
} catch {
  sculptures = [];
}
---
<BaseLayout title={t.sculptures.title} canonicalPath="/sculptures">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="text-4xl md:text-5xl mb-8">{t.sculptures.title}</h1>
    {sculptures.length === 0 ? (
      <p class="text-[color:var(--color-muted)]">{t.sculptures.empty}</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {sculptures.map((artwork) => <ArtworkCard artwork={artwork} />)}
      </div>
    )}
  </section>
</BaseLayout>
