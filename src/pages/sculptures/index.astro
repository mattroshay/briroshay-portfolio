---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArtworksByType } from '../../lib/queries';
import { urlFor } from '../../lib/sanity';
import { pickLocale, getLocaleFromUrl, useTranslations, localePath } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

let sculptures: Awaited<ReturnType<typeof getArtworksByType>> = [];
try {
  sculptures = await getArtworksByType('sculpture');
} catch {
  sculptures = [];
}

const TONES = ['warm', 'cool', 'dark'] as const;
---
<BaseLayout
  title={t.sculptures.title}
  description={t.sculptures.blurb}
  canonicalPath="/sculptures"
  navKey="sculptures"
>
  <header class="page-head wrap">
    <div class="page-head-bar">
      <a href={localePath(locale, '/')} class="page-back">
        <span aria-hidden="true">←</span>
        <span>{t.nav.backToStudio}</span>
      </a>
      <div class="mono-sm">/02 — {t.sculptures.label}</div>
    </div>
    <h1 class="page-title fade-up">
      {t.sculptures.titleA}<span class="accent">{t.sculptures.titleAccent}</span>{t.sculptures.titleB}
    </h1>
    <p class="page-blurb fade-up" style="transition-delay: 120ms;">{t.sculptures.blurb}</p>
  </header>

  <section class="section wrap" id="sculptures">
    <div class="gallery">
      {sculptures.length === 0 ? (
        <div class="filter-empty">
          <div class="mono-sm">{t.sculptures.empty}</div>
        </div>
      ) : (
        sculptures.map((artwork, i) => {
          const slug = pickLocale(artwork.slug, locale) ?? artwork.slug?.en;
          const title = pickLocale(artwork.title, locale) ?? '';
          const primary = artwork.images?.find((img) => img.isPrimary) ?? artwork.images?.[0];
          const altText = pickLocale(primary?.alt, locale) ?? title;
          const year = artwork.dateCreated ? new Date(artwork.dateCreated).getFullYear() : '';
          const tone = TONES[i % TONES.length];
          const href = slug ? localePath(locale, `/sculptures/${slug}`) : '#';
          return (
            <a
              href={href}
              class="art-card span-square"
              aria-label={title}
            >
              {primary ? (
                <img
                  src={urlFor(primary).width(800).auto('format').url()}
                  srcset={[400, 800, 1200]
                    .map((w) => `${urlFor(primary).width(w).auto('format').url()} ${w}w`)
                    .join(', ')}
                  sizes="(max-width: 768px) 50vw, 25vw"
                  alt={altText}
                  loading="lazy"
                />
              ) : (
                <div class={`art-ph ${tone}`}>{'◆ SCULPTURE\nPHOTO'}</div>
              )}
              <div class="meta">
                <span class="t">{title}</span>
                {year && <span class="y">{year}</span>}
              </div>
            </a>
          );
        })
      )}
    </div>

    <div class="section-action">
      <span class="mono-sm">{t.sculptures.allUnique}</span>
      <a href="#" class="btn-line">{t.sculptures.viewAll} →</a>
    </div>
  </section>
</BaseLayout>
