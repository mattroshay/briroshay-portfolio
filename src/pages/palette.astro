---
const title = 'Design Palette · Brigitte Roshay';
const description =
  'Working palette for the portfolio — colour, type, surface, usage. Internal review document.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;700;800;900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;0,6..96,800;0,6..96,900;1,6..96,500&family=Archivo+Black&family=DM+Sans:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body data-page="palette">
    <div class="tex-layer tex-paper" aria-hidden="true"></div>

    <nav class="nav">
      <a href="/" class="nav-mark">
        Brigitte Roshay<span class="star">★</span>
      </a>
      <div class="nav-links">
        <a href="/paintings">Paintings</a>
        <a href="/sculptures">Sculptures</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="nav-actions">
        <a href="/" class="page-back">← Index</a>
      </div>
    </nav>

    <main class="wrap pal-page">
      <header class="pal-hd">
        <div>
          <div class="mono" style="color: var(--accent-1); margin-bottom: 18px;">
            ⌑ Design palette · v1 · May 2026
          </div>
          <h1 class="title">
            Colour<br /><span class="ampr">&amp;</span>Surface
          </h1>
        </div>
        <div class="body">
          <p>
            A working palette for the portfolio — a dark, low-saturation gallery shell that lets the
            paintings carry colour, with two accents that nod to the warmth and shadow already in the
            work: <b>ochre</b> for highlight, <b>teal</b> for cool counter-light.
          </p>
          <p>
            Three alternative palettes follow. Each is shown as a swatch ribbon, a token table, and a
            tiny live specimen rendered with that palette's actual values so you can read it in
            context, not as abstract colour chips.
          </p>
          <div class="meta">
            <span>Maker · <b>Studio Roshay</b></span>
            <span>Pairs with · <b>Big Shoulders / Bodoni / DM Sans</b></span>
            <span>Status · <b style="color: var(--accent-1);">In review</b></span>
          </div>
        </div>
      </header>

      <section class="pal-section">
        <div class="hd">
          <div class="n">§ 01</div>
          <div class="t">Palettes</div>
          <div class="k">Four directions · pick one or two</div>
        </div>

        <div class="pal-grid">
          <article
            class="pal-card featured"
            style="
              --c-bg: oklch(0.14 0.012 65);
              --c-bg-elev: oklch(0.22 0.014 65);
              --c-fg: oklch(0.96 0.006 80);
              --c-fg-soft: oklch(0.82 0.008 80);
              --c-line: oklch(0.32 0.012 70);
              --c-acc1: oklch(0.80 0.14 80);
              --c-acc2: oklch(0.66 0.09 200);
            "
          >
            <div class="row1">
              <div class="name">Ochre <br />&amp; Teal</div>
              <span class="tag live">★ Live · default</span>
            </div>
            <p class="blurb">
              Warm gold against a near-black sepia. Teal pulls cool shadows out of the paintings.
              House palette — what's running today.
            </p>

            <div class="swatch-bar">
              <div class="sw" style="background: oklch(0.14 0.012 65)"><span class="lbl">bg</span></div>
              <div class="sw" style="background: oklch(0.22 0.014 65)"><span class="lbl">elev</span></div>
              <div class="sw" style="background: oklch(0.96 0.006 80)">
                <span class="lbl" style="color: oklch(0.14 0.012 65); mix-blend-mode: normal;">fg</span>
              </div>
              <div class="sw" style="background: oklch(0.80 0.14 80)">
                <span class="lbl" style="color: oklch(0.18 0.02 70); mix-blend-mode: normal;">ochre</span>
              </div>
              <div class="sw" style="background: oklch(0.66 0.09 200)">
                <span class="lbl" style="color: oklch(0.14 0.04 210); mix-blend-mode: normal;">teal</span>
              </div>
            </div>

            <div class="specimen">
              <div class="specimen-inner">
                <div class="sp-num">§ 02 — Featured</div>
                <div class="sp-title">Quiet <span class="a1">light</span>, deep <span class="a2">shade</span></div>
                <div class="sp-body">
                  A study of forest interiors and slow afternoons. Twelve oils, three on paper.
                </div>
                <div class="sp-row">
                  <span class="sp-pill fill">View shop</span>
                  <span class="sp-pill ghost">Read essay</span>
                </div>
              </div>
            </div>

            <div class="tokens">
              <div class="row"><span class="k">bg</span><span class="v">oklch(.14 .012 65)</span></div>
              <div class="row"><span class="k">fg</span><span class="v">oklch(.96 .006 80)</span></div>
              <div class="row"><span class="k">acc-1</span><span class="v">oklch(.80 .14 80)</span></div>
              <div class="row"><span class="k">acc-2</span><span class="v">oklch(.66 .09 200)</span></div>
            </div>
          </article>

          <article
            class="pal-card"
            style="
              --c-bg: oklch(0.13 0.008 50);
              --c-bg-elev: oklch(0.21 0.012 55);
              --c-fg: oklch(0.94 0.012 80);
              --c-fg-soft: oklch(0.78 0.010 75);
              --c-line: oklch(0.30 0.014 60);
              --c-acc1: oklch(0.68 0.10 55);
              --c-acc2: oklch(0.52 0.05 240);
            "
          >
            <div class="row1">
              <div class="name">Forest <br />Floor</div>
              <span class="tag">Proposed · new</span>
            </div>
            <p class="blurb">
              Pulled from the lakeside-trees painting — earth umber where ochre was, and a
              desaturated dusk blue instead of teal. Quieter, more painterly.
            </p>

            <div class="swatch-bar">
              <div class="sw" style="background: oklch(0.13 0.008 50)"><span class="lbl">bg</span></div>
              <div class="sw" style="background: oklch(0.21 0.012 55)"><span class="lbl">elev</span></div>
              <div class="sw" style="background: oklch(0.94 0.012 80)">
                <span class="lbl" style="color: oklch(0.13 0.008 50); mix-blend-mode: normal;">fg</span>
              </div>
              <div class="sw" style="background: oklch(0.68 0.10 55)">
                <span class="lbl" style="color: oklch(0.15 0.02 50); mix-blend-mode: normal;">umber</span>
              </div>
              <div class="sw" style="background: oklch(0.52 0.05 240)">
                <span class="lbl" style="color: oklch(0.94 0.01 80); mix-blend-mode: normal;">dusk</span>
              </div>
            </div>

            <div class="specimen">
              <div class="specimen-inner">
                <div class="sp-num">§ 02 — Featured</div>
                <div class="sp-title">Quiet <span class="a1">light</span>, deep <span class="a2">shade</span></div>
                <div class="sp-body">
                  A study of forest interiors and slow afternoons. Twelve oils, three on paper.
                </div>
                <div class="sp-row">
                  <span class="sp-pill fill">View shop</span>
                  <span class="sp-pill ghost">Read essay</span>
                </div>
              </div>
            </div>

            <div class="tokens">
              <div class="row"><span class="k">bg</span><span class="v">oklch(.13 .008 50)</span></div>
              <div class="row"><span class="k">fg</span><span class="v">oklch(.94 .012 80)</span></div>
              <div class="row"><span class="k">umber</span><span class="v">oklch(.68 .10 55)</span></div>
              <div class="row"><span class="k">dusk</span><span class="v">oklch(.52 .05 240)</span></div>
            </div>
          </article>

          <article
            class="pal-card"
            style="
              --c-bg: oklch(0.15 0.012 30);
              --c-bg-elev: oklch(0.22 0.018 30);
              --c-fg: oklch(0.96 0.008 40);
              --c-fg-soft: oklch(0.82 0.010 40);
              --c-line: oklch(0.34 0.020 35);
              --c-acc1: oklch(0.72 0.13 25);
              --c-acc2: oklch(0.58 0.06 50);
            "
          >
            <div class="row1">
              <div class="name">Rose<br />Clay</div>
              <span class="tag">Existing · alt</span>
            </div>
            <p class="blurb">
              Warmer end of the spectrum — terracotta and rust. Already in the codebase under
              <span style="font-family: var(--font-mono); color: var(--fg);">.palette-rose-clay</span>;
              surfaced here so you can read it next to the others.
            </p>

            <div class="swatch-bar">
              <div class="sw" style="background: oklch(0.15 0.012 30)"><span class="lbl">bg</span></div>
              <div class="sw" style="background: oklch(0.22 0.018 30)"><span class="lbl">elev</span></div>
              <div class="sw" style="background: oklch(0.96 0.008 40)">
                <span class="lbl" style="color: oklch(0.15 0.012 30); mix-blend-mode: normal;">fg</span>
              </div>
              <div class="sw" style="background: oklch(0.72 0.13 25)">
                <span class="lbl" style="color: oklch(0.18 0.04 25); mix-blend-mode: normal;">rose</span>
              </div>
              <div class="sw" style="background: oklch(0.58 0.06 50)">
                <span class="lbl" style="color: oklch(0.18 0.04 50); mix-blend-mode: normal;">clay</span>
              </div>
            </div>

            <div class="specimen">
              <div class="specimen-inner">
                <div class="sp-num">§ 02 — Featured</div>
                <div class="sp-title">Quiet <span class="a1">light</span>, deep <span class="a2">shade</span></div>
                <div class="sp-body">
                  A study of forest interiors and slow afternoons. Twelve oils, three on paper.
                </div>
                <div class="sp-row">
                  <span class="sp-pill fill">View shop</span>
                  <span class="sp-pill ghost">Read essay</span>
                </div>
              </div>
            </div>

            <div class="tokens">
              <div class="row"><span class="k">bg</span><span class="v">oklch(.15 .012 30)</span></div>
              <div class="row"><span class="k">fg</span><span class="v">oklch(.96 .008 40)</span></div>
              <div class="row"><span class="k">rose</span><span class="v">oklch(.72 .13 25)</span></div>
              <div class="row"><span class="k">clay</span><span class="v">oklch(.58 .06 50)</span></div>
            </div>
          </article>

          <article
            class="pal-card"
            style="
              --c-bg: oklch(0.97 0.004 80);
              --c-bg-elev: oklch(0.94 0.006 80);
              --c-fg: oklch(0.16 0.012 65);
              --c-fg-soft: oklch(0.36 0.012 65);
              --c-line: oklch(0.84 0.008 70);
              --c-acc1: oklch(0.45 0.16 270);
              --c-acc2: oklch(0.55 0.13 35);
            "
          >
            <div class="row1">
              <div class="name">Paper<br />&amp; Indigo</div>
              <span class="tag">Proposed · light</span>
            </div>
            <p class="blurb">
              Counterpoint: a museum-catalogue light mode. Warm paper white, near-black ink, single
              indigo accent with a small terracotta pop for sale tags and "new" markers.
            </p>

            <div class="swatch-bar">
              <div class="sw" style="background: oklch(0.97 0.004 80)">
                <span class="lbl" style="color: oklch(0.16 0.012 65); mix-blend-mode: normal;">paper</span>
              </div>
              <div class="sw" style="background: oklch(0.94 0.006 80)">
                <span class="lbl" style="color: oklch(0.16 0.012 65); mix-blend-mode: normal;">soft</span>
              </div>
              <div class="sw" style="background: oklch(0.16 0.012 65)"><span class="lbl">ink</span></div>
              <div class="sw" style="background: oklch(0.45 0.16 270)"><span class="lbl">indigo</span></div>
              <div class="sw" style="background: oklch(0.55 0.13 35)"><span class="lbl">terra</span></div>
            </div>

            <div class="specimen">
              <div class="specimen-inner">
                <div class="sp-num">§ 02 — Featured</div>
                <div class="sp-title">Quiet <span class="a1">light</span>, deep <span class="a2">shade</span></div>
                <div class="sp-body">
                  A study of forest interiors and slow afternoons. Twelve oils, three on paper.
                </div>
                <div class="sp-row">
                  <span class="sp-pill fill">View shop</span>
                  <span class="sp-pill ghost">Read essay</span>
                </div>
              </div>
            </div>

            <div class="tokens">
              <div class="row"><span class="k">paper</span><span class="v">oklch(.97 .004 80)</span></div>
              <div class="row"><span class="k">ink</span><span class="v">oklch(.16 .012 65)</span></div>
              <div class="row"><span class="k">indigo</span><span class="v">oklch(.45 .16 270)</span></div>
              <div class="row"><span class="k">terra</span><span class="v">oklch(.55 .13 35)</span></div>
            </div>
          </article>
        </div>

        <div class="notes">
          <div class="note">
            <div class="label">— Approach</div>
            All four palettes share the same <b>chroma envelope</b> (≤0.16) and the same
            <b>hue families</b> as the work itself — warm earth + cool counter-light. Nothing screams;
            the paintings stay the loudest thing on the page.
          </div>
          <div class="note">
            <div class="label">— Recommendation</div>
            Keep <b>Ochre &amp; Teal</b> as the daily driver. Add <b>Forest Floor</b> as a seasonal
            alternate the tweaks panel can switch into for the next show. Hold
            <b>Paper &amp; Indigo</b> for printed catalogues and PDFs.
          </div>
          <div class="note">
            <div class="label">— Contrast</div>
            All foregrounds clear <b>WCAG AA</b> against their backgrounds. Accents are <b>not</b>
            safe for body text — reserved for headings, section markers, hover states, and the
            marquee.
          </div>
        </div>
      </section>

      <section class="pal-section">
        <div class="hd">
          <div class="n">§ 02</div>
          <div class="t">Type pairings</div>
          <div class="k">Display · Body · Mono</div>
        </div>

        <div class="type-grid">
          <div class="type-card t1">
            <div class="badge"><span>A · Condensed</span><span class="b">★ Live</span></div>
            <div class="specimen-type">Brigitte<br /><span class="it">&amp;</span>Roshay</div>
            <div class="body-sample">
              Paintings, sculpture, the long pull of a place.
              <b style="color: var(--fg);">DM Sans</b> at 16px carries the body;
              <b style="color: var(--fg);">Space Mono</b> at 11px tags every section and meta line.
            </div>
            <div class="meta-rows">
              <div class="r"><span>Display</span><b>Big Shoulders Display 900</b></div>
              <div class="r"><span>Body</span><b>DM Sans 400 / 500</b></div>
              <div class="r"><span>Mono</span><b>Space Mono 400</b></div>
              <div class="r"><span>Stretch</span><b>condensed, line 0.85</b></div>
            </div>
            <div class="mono-sample">§ 04 — Selected works · 2019–2026</div>
          </div>

          <div class="type-card t2">
            <div class="badge"><span>B · Editorial</span><span class="b">Alt</span></div>
            <div class="specimen-type">Brigitte<br /><span class="it">&amp;</span>Roshay</div>
            <div class="body-sample">
              A more catalogue-feeling direction. <b style="color: var(--fg);">Bodoni Moda</b> at a
              heavy display weight, italic ampersand kept. Reads quieter, more "museum bookshop."
            </div>
            <div class="meta-rows">
              <div class="r"><span>Display</span><b>Bodoni Moda 900</b></div>
              <div class="r"><span>Body</span><b>DM Sans 400</b></div>
              <div class="r"><span>Mono</span><b>Space Mono 400</b></div>
              <div class="r"><span>Stretch</span><b>normal, line 0.95</b></div>
            </div>
            <div class="mono-sample">§ 04 — Selected works · 2019–2026</div>
          </div>

          <div class="type-card t3">
            <div class="badge"><span>C · Geometric</span><span class="b">Alt</span></div>
            <div class="specimen-type">Brigitte<br /><span class="it">&amp;</span>Roshay</div>
            <div class="body-sample">
              Heaviest and flattest of the three. <b style="color: var(--fg);">Archivo Black</b>
              trades elegance for graphic punch. Good for a single landing screen, can feel loud
              across a whole site.
            </div>
            <div class="meta-rows">
              <div class="r"><span>Display</span><b>Archivo Black 400</b></div>
              <div class="r"><span>Body</span><b>DM Sans 400</b></div>
              <div class="r"><span>Mono</span><b>Space Mono 400</b></div>
              <div class="r"><span>Stretch</span><b>normal, line 0.92</b></div>
            </div>
            <div class="mono-sample">§ 04 — Selected works · 2019–2026</div>
          </div>
        </div>
      </section>

      <section class="pal-section">
        <div class="hd">
          <div class="n">§ 03</div>
          <div class="t">Surface &amp; texture</div>
          <div class="k">Overlays on bg · ≤ 8% opacity</div>
        </div>

        <div class="tex-grid">
          <div class="tex-card">
            <div class="ph"></div>
            <div class="num">01</div>
            <div class="lbl">No overlay</div>
          </div>
          <div class="tex-card">
            <div class="ph"></div>
            <div class="tex-overlay paper"></div>
            <div class="num">02</div>
            <div class="lbl">★ Paper · live</div>
          </div>
          <div class="tex-card">
            <div class="ph"></div>
            <div class="tex-overlay grain"></div>
            <div class="num">03</div>
            <div class="lbl">Grain</div>
          </div>
          <div class="tex-card">
            <div class="ph"></div>
            <div class="tex-overlay vignette"></div>
            <div class="num">04</div>
            <div class="lbl">Vignette</div>
          </div>
        </div>

        <div class="notes two">
          <div class="note">
            <div class="label">— Texture</div>
            A whisper of <b>paper noise</b> at 6–8% opacity keeps the dark surface from feeling like
            a flat screen. Anything heavier starts to compete with the paintings.
          </div>
          <div class="note">
            <div class="label">— Don't combine</div>
            Use <b>one</b> overlay only. Grain + vignette together reads as filter, not surface.
          </div>
        </div>
      </section>

      <section class="pal-section">
        <div class="hd">
          <div class="n">§ 04</div>
          <div class="t">Where each colour lives</div>
          <div class="k">Approximate share of pixels</div>
        </div>

        <div class="usage">
          <div class="row">
            <span>Background</span>
            <span class="bar"><span class="seg" style="left:0; right:30%; background: var(--bg);"></span></span>
            <span class="pct">≈ 70%</span>
          </div>
          <div class="row">
            <span>Elevated</span>
            <span class="bar"><span class="seg" style="left:0; right:82%; background: var(--bg-elev);"></span></span>
            <span class="pct">≈ 18%</span>
          </div>
          <div class="row">
            <span>Foreground</span>
            <span class="bar"><span class="seg" style="left:0; right:92%; background: var(--fg);"></span></span>
            <span class="pct">≈ 8%</span>
          </div>
          <div class="row">
            <span>Accent 1 — ochre</span>
            <span class="bar"><span class="seg" style="left:0; right:97%; background: var(--accent-1);"></span></span>
            <span class="pct">≈ 3%</span>
          </div>
          <div class="row">
            <span>Accent 2 — teal</span>
            <span class="bar"><span class="seg" style="left:0; right:99%; background: var(--accent-2);"></span></span>
            <span class="pct">≈ 1%</span>
          </div>
        </div>

        <div class="notes">
          <div class="note">
            <div class="label">— Ochre belongs to</div>
            Section numerals, the star glyph, "upcoming" tags, marquee ribbon, primary buttons,
            hover underlines.
          </div>
          <div class="note">
            <div class="label">— Teal belongs to</div>
            Sculpture-section accents, secondary headings, the signature pop on the title plate,
            occasional placeholder card.
          </div>
          <div class="note">
            <div class="label">— Never paint</div>
            Body paragraphs, long captions, form input text, the painting thumbnails themselves —
            those stay on the neutral scale.
          </div>
        </div>
      </section>

      <footer class="foot">
        <div class="foot-name">
          Palette <span class="ampr">&amp;</span> Surface
        </div>
        <div class="foot-meta">
          <span>Studio Roshay · Internal · v1</span>
          <span>For review · May 2026</span>
          <span><a href="/" style="color: var(--accent-1);">↩ back to site</a></span>
        </div>
      </footer>
    </main>

    <style is:global>
      /* ── Design tokens ── */
      :root {
        --bg:        oklch(0.14 0.012 65);
        --bg-soft:   oklch(0.18 0.012 65);
        --bg-elev:   oklch(0.22 0.014 65);
        --fg:        oklch(0.96 0.006 80);
        --fg-soft:   oklch(0.82 0.008 80);
        --fg-mute:   oklch(0.58 0.012 80);
        --line:      oklch(0.32 0.012 70);
        --line-soft: oklch(0.24 0.012 70);

        --ochre:      oklch(0.80 0.14 80);
        --ochre-deep: oklch(0.62 0.14 70);
        --teal:       oklch(0.66 0.09 200);
        --teal-deep:  oklch(0.45 0.08 210);
        --accent-1:   var(--ochre);
        --accent-2:   var(--teal);

        --font-display: 'Big Shoulders Display', 'Impact', sans-serif;
        --font-body:    'DM Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-mono:    'Space Mono', ui-monospace, 'SF Mono', monospace;

        --display-tracking: -0.02em;
        --display-weight: 900;
        --display-line: 0.85;

        --gap-xxs: 4px;
        --gap-xs:  8px;
        --gap-sm:  12px;
        --gap-md:  20px;
        --gap-lg:  36px;
        --gap-xl:  64px;
        --gap-xxl: 96px;
        --pad-x:   24px;

        --texture-opacity: 0.06;
      }
      @media (min-width: 768px)  { :root { --pad-x: 40px; } }
      @media (min-width: 1280px) { :root { --pad-x: 56px; } }

      /* ── Reset ── */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body[data-page="palette"] {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        min-height: 100vh;
        position: relative;
        padding-bottom: 80px;
      }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }

      /* ── Paper texture layer ── */
      .tex-layer {
        position: fixed; inset: 0; pointer-events: none; z-index: 1;
        opacity: var(--texture-opacity);
        mix-blend-mode: overlay;
      }
      .tex-layer.tex-paper {
        background-image:
          url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.95 0 0 0 0 0.92 0 0 0 0 0.86 0 0 0 0.7 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
      }

      /* ── Layout primitives ── */
      .wrap {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 var(--pad-x);
        position: relative;
        z-index: 2;
      }
      .mono {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.10em;
        text-transform: uppercase;
      }

      /* ── Nav ── */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px var(--pad-x);
        background: color-mix(in oklab, var(--bg) 80%, transparent);
        -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line-soft);
      }
      .nav-mark {
        font-family: var(--font-display);
        font-weight: var(--display-weight);
        font-size: 22px;
        letter-spacing: var(--display-tracking);
        line-height: 1;
        padding-right: 14px;
      }
      .nav-mark .star {
        color: var(--accent-1);
        margin-left: 4px;
        font-size: 10px;
        vertical-align: top;
      }
      .nav-links {
        display: none;
        gap: 28px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav-links a { color: var(--fg-soft); transition: color .15s; }
      .nav-links a:hover { color: var(--accent-1); }
      .nav-actions { display: flex; align-items: center; gap: 10px; }
      .page-back {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px; border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--fg-soft);
        font-family: var(--font-mono); font-size: 11px;
        letter-spacing: 0.10em; text-transform: uppercase;
        transition: all .15s;
      }
      .page-back:hover { border-color: var(--accent-1); color: var(--accent-1); }
      @media (min-width: 900px) {
        .nav-links { display: flex; }
      }

      /* ── Palette page ── */
      .pal-page { padding-top: var(--gap-md); }

      .pal-hd {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--gap-md);
        padding-bottom: var(--gap-lg);
        border-bottom: 1px solid var(--line-soft);
        margin-bottom: var(--gap-lg);
      }
      @media (min-width: 900px) {
        .pal-hd { grid-template-columns: 1.3fr 1fr; align-items: end; gap: var(--gap-xl); }
      }
      .pal-hd .title {
        font-family: var(--font-display);
        font-weight: var(--display-weight);
        letter-spacing: var(--display-tracking);
        line-height: 0.82;
        font-size: clamp(64px, 14vw, 180px);
        text-transform: uppercase;
      }
      .pal-hd .title .ampr {
        font-family: 'Bodoni Moda', serif;
        font-style: italic; font-weight: 500;
        color: var(--accent-1);
        font-size: 0.7em;
        letter-spacing: 0;
        text-transform: none;
        margin: 0 .04em;
      }
      .pal-hd .body { color: var(--fg-soft); max-width: 44ch; text-wrap: pretty; }
      .pal-hd .body p + p { margin-top: 10px; }
      .pal-hd .meta {
        margin-top: var(--gap-md);
        display: flex; flex-wrap: wrap; gap: 18px;
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .12em; text-transform: uppercase;
        color: var(--fg-mute);
      }
      .pal-hd .meta b { color: var(--fg); font-weight: 400; }

      /* Section heading */
      .pal-section { margin-top: var(--gap-xl); }
      .pal-section + .pal-section { margin-top: var(--gap-xxl); }
      .pal-section .hd {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-bottom: var(--gap-md);
        padding-bottom: var(--gap-sm);
        border-bottom: 1px solid var(--line-soft);
      }
      @media (min-width: 768px) {
        .pal-section .hd { grid-template-columns: auto 1fr auto; align-items: baseline; gap: var(--gap-md); }
      }
      .pal-section .hd .n {
        font-family: var(--font-mono); font-size: 11px;
        letter-spacing: .12em; color: var(--accent-1);
        display: inline-flex; align-items: center; gap: 8px;
      }
      .pal-section .hd .n::before {
        content: ""; width: 6px; height: 6px; border-radius: 999px; background: var(--accent-1);
      }
      .pal-section .hd .t {
        font-family: var(--font-display); font-weight: var(--display-weight);
        letter-spacing: var(--display-tracking);
        font-size: clamp(28px, 4.5vw, 48px);
        text-transform: uppercase; line-height: 0.95;
      }
      .pal-section .hd .k {
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .12em; text-transform: uppercase;
        color: var(--fg-mute);
      }

      /* Palette card */
      .pal-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--gap-md);
      }
      @media (min-width: 768px) { .pal-grid { grid-template-columns: 1fr 1fr; gap: var(--gap-lg); } }

      .pal-card {
        border: 1px solid var(--line);
        background: var(--bg-soft);
        padding: var(--gap-md);
        display: flex; flex-direction: column; gap: var(--gap-sm);
        position: relative;
      }
      .pal-card.featured {
        border-color: var(--accent-1);
        box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent-1) 25%, transparent);
      }
      .pal-card .row1 {
        display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
      }
      .pal-card .name {
        font-family: var(--font-display); font-weight: var(--display-weight);
        letter-spacing: var(--display-tracking);
        font-size: clamp(28px, 3.4vw, 38px);
        line-height: 0.95; text-transform: uppercase;
      }
      .pal-card .tag {
        font-family: var(--font-mono); font-size: 9px;
        letter-spacing: .12em; text-transform: uppercase;
        padding: 4px 10px; border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--fg-mute); white-space: nowrap;
      }
      .pal-card .tag.live {
        color: var(--accent-1); border-color: var(--accent-1);
        background: color-mix(in oklab, var(--accent-1) 10%, transparent);
      }
      .pal-card .blurb { color: var(--fg-soft); font-size: 13.5px; max-width: 48ch; text-wrap: pretty; }

      /* Swatch bar */
      .swatch-bar {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        height: 88px;
        border: 1px solid var(--line-soft);
        margin-top: 6px;
        overflow: hidden;
      }
      .swatch-bar .sw {
        position: relative;
        display: flex; align-items: end;
        padding: 8px 9px;
      }
      .swatch-bar .sw .lbl {
        font-family: var(--font-mono); font-size: 8.5px;
        letter-spacing: .10em; text-transform: uppercase;
        mix-blend-mode: difference; color: white; opacity: .85;
      }

      /* Specimen */
      .specimen {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        padding: var(--gap-sm);
        border: 1px dashed var(--line-soft);
        background:
          repeating-linear-gradient(45deg,
            color-mix(in oklab, var(--c-bg) 100%, transparent) 0 8px,
            color-mix(in oklab, var(--c-bg-elev) 100%, transparent) 8px 16px);
        color: var(--c-fg);
        min-height: 180px;
        position: relative;
      }
      .specimen-inner {
        background: var(--c-bg);
        padding: 14px 14px 12px;
        border: 1px solid var(--c-line);
        display: flex; flex-direction: column; gap: 8px;
      }
      .specimen .sp-num {
        font-family: var(--font-mono); font-size: 9px;
        letter-spacing: .12em; color: var(--c-acc1);
        display: inline-flex; align-items: center; gap: 6px;
      }
      .specimen .sp-num::before {
        content: ""; width: 5px; height: 5px; border-radius: 999px; background: var(--c-acc1);
      }
      .specimen .sp-title {
        font-family: var(--font-display); font-weight: var(--display-weight);
        letter-spacing: var(--display-tracking);
        font-size: clamp(28px, 5vw, 44px);
        line-height: 0.9; text-transform: uppercase;
        color: var(--c-fg);
      }
      .specimen .sp-title .a1 { color: var(--c-acc1); }
      .specimen .sp-title .a2 { color: var(--c-acc2); }
      .specimen .sp-body { color: var(--c-fg-soft); font-size: 12.5px; line-height: 1.5; max-width: 40ch; }
      .specimen .sp-row {
        display: flex; gap: 6px; margin-top: 2px; flex-wrap: wrap;
      }
      .specimen .sp-pill {
        font-family: var(--font-mono); font-size: 9px;
        letter-spacing: .10em; text-transform: uppercase;
        padding: 4px 8px; border-radius: 999px;
        border: 1px solid var(--c-line);
        color: var(--c-fg-soft);
      }
      .specimen .sp-pill.fill { background: var(--c-acc1); color: var(--c-bg); border-color: var(--c-acc1); }
      .specimen .sp-pill.ghost { color: var(--c-acc2); border-color: var(--c-acc2); }

      /* Token list */
      .tokens {
        display: grid; grid-template-columns: 1fr 1fr; gap: 4px 14px;
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .04em; color: var(--fg-mute);
      }
      .tokens .k { color: var(--fg-mute); }
      .tokens .v { color: var(--fg-soft); text-transform: lowercase; font-variant-numeric: tabular-nums; }
      .tokens .row { display: contents; }
      .tokens .row .k::before { content: "—  "; color: var(--accent-1); opacity: .6; }

      /* Type pairings */
      .type-grid {
        display: grid; gap: var(--gap-md);
        grid-template-columns: 1fr;
      }
      @media (min-width: 900px) { .type-grid { grid-template-columns: repeat(3, 1fr); } }
      .type-card {
        border: 1px solid var(--line);
        background: var(--bg-soft);
        padding: var(--gap-md);
        display: flex; flex-direction: column; gap: var(--gap-sm);
      }
      .type-card .badge {
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .12em; color: var(--fg-mute);
        text-transform: uppercase;
        display: flex; justify-content: space-between; align-items: baseline;
      }
      .type-card .badge .b { color: var(--accent-1); }
      .type-card .specimen-type {
        line-height: 0.82;
        text-transform: uppercase;
        font-size: clamp(56px, 7vw, 92px);
        letter-spacing: -0.02em;
        text-wrap: balance;
      }
      .type-card .specimen-type .it {
        font-family: 'Bodoni Moda', serif;
        font-style: italic; font-weight: 500;
        color: var(--accent-1);
        text-transform: none;
        font-size: 0.7em;
        letter-spacing: 0;
      }
      .type-card.t1 .specimen-type { font-family: 'Big Shoulders Display', sans-serif; font-weight: 900; }
      .type-card.t2 .specimen-type { font-family: 'Bodoni Moda', serif; font-weight: 900; letter-spacing: -0.01em; }
      .type-card.t3 .specimen-type { font-family: 'Archivo Black', sans-serif; font-weight: 400; line-height: 0.92; letter-spacing: -0.03em; }

      .type-card .meta-rows {
        display: grid; gap: 4px;
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .04em; color: var(--fg-mute);
        border-top: 1px solid var(--line-soft);
        padding-top: var(--gap-sm);
      }
      .type-card .meta-rows .r { display: flex; justify-content: space-between; gap: 10px; }
      .type-card .meta-rows .r b { color: var(--fg-soft); font-weight: 400; }

      .type-card .body-sample {
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px; color: var(--fg-soft); line-height: 1.55;
        text-wrap: pretty;
      }
      .type-card .mono-sample {
        font-family: 'Space Mono', monospace;
        font-size: 11px; letter-spacing: .04em;
        color: var(--fg-mute);
        padding-top: 6px;
        border-top: 1px solid var(--line-soft);
      }

      /* Texture studies */
      .tex-grid {
        display: grid; gap: var(--gap-md);
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (min-width: 768px) { .tex-grid { grid-template-columns: repeat(4, 1fr); } }
      .tex-card {
        aspect-ratio: 1 / 1;
        border: 1px solid var(--line);
        position: relative;
        overflow: hidden;
        background: var(--bg-soft);
      }
      .tex-card .ph {
        position: absolute; inset: 0;
        background:
          repeating-linear-gradient(45deg,
            color-mix(in oklab, var(--accent-1) 12%, var(--bg-soft)) 0 8px,
            color-mix(in oklab, var(--accent-1) 5%, var(--bg-elev)) 8px 16px);
      }
      .tex-card .tex-overlay {
        position: absolute; inset: 0;
        pointer-events: none;
      }
      .tex-card .tex-overlay.paper {
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.95 0 0 0 0 0.92 0 0 0 0 0.86 0 0 0 0.7 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.22; mix-blend-mode: overlay;
      }
      .tex-card .tex-overlay.grain {
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.6' numOctaves='1' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.9'/></svg>");
        opacity: 0.18; mix-blend-mode: overlay;
      }
      .tex-card .tex-overlay.vignette {
        background: radial-gradient(ellipse at center, transparent 35%, rgba(0,0,0,0.85) 130%);
        mix-blend-mode: multiply;
      }
      .tex-card .lbl {
        position: absolute; left: 10px; bottom: 10px;
        font-family: var(--font-mono); font-size: 9.5px;
        letter-spacing: .12em; text-transform: uppercase;
        color: var(--fg);
        background: color-mix(in oklab, var(--bg) 80%, transparent);
        -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
        padding: 5px 9px;
        border: 1px solid var(--line-soft);
      }
      .tex-card .num {
        position: absolute; right: 10px; top: 10px;
        font-family: var(--font-mono); font-size: 9px;
        letter-spacing: .12em; color: var(--fg-mute);
      }

      /* Usage chart */
      .usage {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--gap-sm);
        border: 1px solid var(--line);
        background: var(--bg-soft);
        padding: var(--gap-md);
      }
      .usage .row {
        display: grid;
        grid-template-columns: 110px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--line-soft);
        font-family: var(--font-mono); font-size: 11px;
        letter-spacing: .08em; text-transform: uppercase;
        color: var(--fg-soft);
      }
      .usage .row:last-child { border-bottom: 0; }
      .usage .row .bar {
        height: 10px; position: relative; background: color-mix(in oklab, var(--bg-elev) 100%, transparent);
        overflow: hidden;
      }
      .usage .row .bar .seg { position: absolute; top: 0; bottom: 0; }
      .usage .row .pct { color: var(--fg-mute); font-variant-numeric: tabular-nums; }

      /* Notes column */
      .notes {
        display: grid; gap: var(--gap-md);
        grid-template-columns: 1fr;
        margin-top: var(--gap-lg);
      }
      @media (min-width: 768px) {
        .notes { grid-template-columns: 1fr 1fr 1fr; }
        .notes.two { grid-template-columns: 1fr 1fr; }
      }
      .note {
        border-top: 1px solid var(--line-soft);
        padding-top: var(--gap-sm);
        font-size: 13.5px; color: var(--fg-soft);
        line-height: 1.55;
      }
      .note .label {
        font-family: var(--font-mono); font-size: 10px;
        letter-spacing: .12em; text-transform: uppercase;
        color: var(--accent-1);
        margin-bottom: 6px;
      }
      .note b { color: var(--fg); font-weight: 600; }

      /* Footer */
      .foot {
        border-top: 1px solid var(--line);
        padding: var(--gap-lg) 0 var(--gap-md);
        margin-top: var(--gap-xxl);
      }
      .foot-name {
        font-family: var(--font-display); font-weight: var(--display-weight);
        letter-spacing: var(--display-tracking); line-height: 0.85;
        font-size: clamp(48px, 12vw, 140px);
        text-transform: uppercase;
        display: flex; align-items: end; gap: 14px; flex-wrap: wrap;
      }
      .foot-name .ampr {
        font-family: 'Bodoni Moda', serif;
        font-style: italic; font-weight: 500;
        color: var(--accent-1);
        font-size: 0.7em;
        letter-spacing: 0;
        text-transform: none;
      }
      .foot-meta {
        margin-top: var(--gap-md);
        display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--gap-md);
        font-family: var(--font-mono); font-size: 10px; color: var(--fg-mute);
        letter-spacing: 0.10em; text-transform: uppercase;
      }
    </style>
  </body>
</html>
